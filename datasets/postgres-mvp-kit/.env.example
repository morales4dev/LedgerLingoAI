# Copy to .env and adjust as needed
POSTGRES_DB=erp_mvp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_pass
POSTGRES_PORT=5433

# Path to source dataset relative to repo root
DATASET_DIR=financial-output

# Optional pipeline behavior flags
# 1 = run git lfs pull in target machine, 0 = skip
FETCH_LFS=1
